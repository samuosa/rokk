# Absolute site ORIGIN ONLY (protocol + host, no path) used for canonical
# URLs, Open Graph tags, JSON-LD and the generated sitemap.xml — VITE_BASE_PATH
# below supplies the sub-path, so never put "/<repo-name>" in this value or
# it gets duplicated (".../rokk/rokk/..."). Copy to .env.local and set per
# environment.
#
# GitHub Pages test build:
#   VITE_SITE_URL=https://<owner>.github.io
# Ionos production build (custom domain, served from "/"):
#   VITE_SITE_URL=https://rokk.xyz
VITE_SITE_URL=https://rokk.xyz

# Deploy sub-path. Leave unset ("/") for Ionos, and for any deploy served
# from a domain root. The GitHub Actions workflow sets this automatically
# from the live Pages configuration (a sub-path for a project site, "/" for
# a custom domain) — you normally don't need to set it by hand.
# VITE_BASE_PATH=/rokk-punk-x-tekk/
